<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | DuffleCraftCo</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<div class="admin-login-wrap">
  <div class="admin-login-card">
    <div class="login-logo">DuffleCraft<span>Co</span></div>
    <h2>Admin Panel</h2>
    <p>Sign in to manage products and inquiries.</p>

    <%- include('../partials/flash') %>

    <form action="/admin/login" method="POST" class="login-form">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="admin" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Login →</button>
    </form>

    <a href="/" class="back-link">← Back to website</a>
  </div>
</div>
</body>
</html>

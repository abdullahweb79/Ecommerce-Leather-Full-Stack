<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof adminTitle !== 'undefined' ? adminTitle : 'Dashboard' %> | DuffleCraftCo Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="sidebar-logo">Leather<span>Co</span></div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">
        📊 Dashboard
      </a>
      <a href="/admin/products" class="<%= typeof activeNav !== 'undefined' && activeNav === 'products' ? 'active' : '' %>">
        👜 Products
      </a>
      <a href="/admin/inquiries" class="<%= typeof activeNav !== 'undefined' && activeNav === 'inquiries' ? 'active' : '' %>">
        📨 Inquiries
      </a>
      <div class="sidebar-divider"></div>
      <a href="/" target="_blank">🌐 View Website</a>
      <a href="/admin/logout" class="logout-link">🚪 Logout</a>
    </nav>
    <div class="sidebar-admin">
      Logged in as <strong><%= admin ? admin.username : 'Admin' %></strong>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title"><%= typeof adminTitle !== 'undefined' ? adminTitle : 'Dashboard' %></h1>
    </div>
    <%- include('../partials/flash') %>
